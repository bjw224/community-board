{
  "manifest_version": 3,
  "name": "커뮤니티 모아보기",
  "version": "1.0.0",
  "description": "클리앙·뽐뿌·다모앙 게시판을 실시간으로 모아 보고 본문까지 한 화면에서 읽기",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "커뮤니티 모아보기 열기", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://*.clien.net/*",
    "https://*.ppomppu.co.kr/*",
    "https://damoang.net/*",
    "https://*.damoang.net/*"
  ]
}
